datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Histórico de Orçamentos Comerciais
model Quote {
  id                  String       @id @default(cuid())
  clientName          String
  clientPhone         String?
  totalAreaM2         Float
  suggestedFinalPrice Decimal  @db.Decimal(12, 2)        // Valor paramétrico de tabela
  finalAgreedPrice    Decimal  @db.Decimal(12, 2) @default(0) 
  discountApplied     Decimal  @db.Decimal(12, 2) @default(0)
  stockDeducted       Boolean      @default(false)
  stockMovement       Json?        // Quantidades baixadas do estoque por itemKey (usado no estorno)
  approvedAt          DateTime?    // Quando a obra foi aprovada (receita entra neste mês no dashboard)
  status              QuoteStatus  @default(PENDENTE)
  roomsData           Json         
  materialsSnapshot   Json         
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("quotes")
}

enum QuoteStatus {
  PENDENTE
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

// 2. Estoque Central & Cargas de Caminhão
model TruckDelivery {
  id                 String   @id @default(cuid())
  date               DateTime @default(now())
  supplier           String   // Ex: Polo do Araripe / Gipsita
  tonsGessoPo        Float    // Toneladas de pó
  platesQuantity     Int      @default(0) // Placas 60x60
  gessoCostTotal     Decimal  @db.Decimal(12, 2)    // Custo na fábrica
  platesCostTotal    Decimal  @db.Decimal(12, 2) @default(0) // Nota das placas (frete/descarga são rateados pelo valor)
  freightCost        Decimal  @db.Decimal(12, 2)    // Frete pago ao caminhão
  unloadingLaborCost Decimal  @db.Decimal(12, 2)    // Chapa/descarga
  realCostPerKg      Decimal  @db.Decimal(12, 4)    // Custo rateado por kg
  notes              String?
  createdAt          DateTime @default(now())

  @@map("truck_deliveries")
}

// 3. Venda Direta no Balcão para Gesseiros Autônomos
model CounterSale {
  id              String   @id @default(cuid())
  customerName    String?  // Nome do gesseiro ou cliente
  itemKey         String   // gessoPoKg, placaGesso60x60, etc.
  quantity        Float    // Quantidade vendida
  unitPrice       Decimal  @db.Decimal(12, 4)    // Preço cobrado
  totalValue      Decimal  @db.Decimal(12, 2)    // Total da venda
  estimatedProfit Decimal  @db.Decimal(12, 2)    // Lucro líquido em cima do custo médio
  createdAt       DateTime @default(now())

  @@map("counter_sales")
}

// 4. Configuração Global de Preços & Coeficientes
model PricingConfig {
  id                     String   @id @default("global_config")
  laborRates             Json     // Tabela de preços de mão de obra
  materialCosts          Json     // Custo unitário de compra dos insumos
  minimumProjectPrice    Decimal  @db.Decimal(12, 2) @default(350)
  profitMarginMultiplier Float    @default(1.35)
  wasteFactor            Float    @default(1.10)
  updatedAt              DateTime @updatedAt

  @@map("pricing_configs")
}

// Adicione ao final do prisma/schema.prisma:

model StockBalance {
  itemKey          String   @id // gessoPoKg, placaGesso60x60, gessoColaKg, arameGalvanizadoKg, sisalKg
  name             String
  unit             String
  currentQuantity  Float
  minThreshold     Float
  averageUnitCost  Decimal  @db.Decimal(12, 4)
  counterSalePrice Decimal  @db.Decimal(12, 4)
  updatedAt        DateTime @updatedAt

  @@map("stock_balances")
}