# Copie para .env (DATABASE_URL) e .env.local (o resto) e preencha. Nunca commite os arquivos reais.

# Banco PostgreSQL (Neon). Use a URL com "-pooler" do painel do Neon.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Chave que assina o cookie de sessão do admin. Obrigatória, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Login do painel /admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
